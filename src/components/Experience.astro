---
const results = [
  {
    label: 'SOP authorship',
    description: 'Wrote standard operating procedures that standardized job roles and daily workflows across clinical teams and market-level operations.',
  },
  {
    label: 'Workflow and checklist design',
    description: 'Designed pre-staging systems, closing checklists, and process documentation now used daily by active clinic teams.',
  },
  {
    label: 'Compliance record',
    description: 'Perfect HIPAA compliance across all clinic operations. Zero breaches, zero missed checkpoints, crash cart materials maintained without exception.',
  },
  {
    label: 'Sustainability tracking',
    description: 'Contributed to recycling tracking and operational sustainability initiatives alongside core operational responsibilities.',
  },
];

const jobs = [
  {
    title: 'Instrument Management & Customer Service Specialist',
    company: 'University of Pennsylvania, Penn Dental Medicine',
    location: 'Philadelphia, PA',
    period: 'May 2023 to present',
    bullets: [
      'Coordinate systems and functions across <strong>5 specialty clinics</strong>, serving <strong>200+ dental students</strong>, <strong>30+ residents</strong>, and <strong>30+ faculty</strong> daily. Zero compliance breaches across all clinical operations.',
      'Maintained a <strong>15-minute</strong> turnaround on high-priority items by building a pre-staging system around sterilization cycle timing.',
      'Sterilized, tracked, and accounted for <strong>1,000+ unique dental instruments</strong> across morning and afternoon sessions.',
      'Cross-train new staff regularly across 5 specialty clinics, each with distinct instrumentation and workflow requirements.',
      'First point of contact for residents and faculty under time pressure: anticipate needs, resolve issues quickly, keep communication accurate.',
      'Produce and maintain clinic documentation including SOPs, signage, checklists, and training materials managed through version-controlled workflows.',
      'Coordinate cross-clinic sourcing and vendor substitutions to prevent stockouts, with proactive updates to any teams affected.',
      'Authored the closing checklist now used by the full sterilization team to standardize end-of-day readiness.',
    ],
  },
  {
    title: 'Operations Associate',
    company: 'The Rounds',
    location: 'Philadelphia, PA',
    period: 'Sep 2021 to Apr 2023',
    bullets: [
      'Coordinated daily delivery routes and shift logistics across the Philadelphia market using Slack and Asana.',
      'Resolved high-volume customer issues and maintained a running log of problems and resolutions for team reference.',
      'Wrote standard operating procedures that restructured job roles and brought clarity to operations across the market.',
      'Promoted from Packing and Delivery Associate to Operations Associate within three months of starting.',
    ],
  },
  {
    title: "Young Adult Leadership Committee / Men's Group Leader",
    company: 'Saint Agatha-Saint James Catholic Church',
    location: 'Philadelphia, PA',
    period: 'Volunteer, 2023 to present',
    bullets: [
      'Produced a <strong>sold-out murder mystery event for 100+ paid attendees</strong>: wrote the original script, designed 9 characters, directed actors, oversaw costume and stage design, managed lighting, booked and paid a live jazz band, and handled all venue logistics with no outside event management support.',
      'Coordinated marketing, ticket sales, and volunteer staffing end-to-end.',
      "Leads a weekly men's group: curates discussion topics and manages ongoing programming.",
    ],
  },
];
---

<section id="results" class="sec" aria-labelledby="results-h">
  <div class="wrap sec-grid">
    <div class="sec-head"><span class="label"><span class="num">02</span>Key results</span></div>
    <div class="sec-body reveal">
      <h2 id="results-h">What I&rsquo;ve <em>built and delivered.</em></h2>
      <div class="results">
        {results.map((r, i) => (
          <div class="result">
            <span class="label">No. {String(i + 1).padStart(2, '0')}</span>
            <h3>{r.label}</h3>
            <p>{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="experience" class="sec" aria-labelledby="experience-h">
  <div class="wrap sec-grid">
    <div class="sec-head"><span class="label"><span class="num">03</span>Experience</span></div>
    <div class="sec-body reveal">
      <h2 id="experience-h">Two very different environments. <em>The same standard.</em></h2>
      <div>
        {jobs.map((job) => (
          <article class="job">
            <div class="job-top">
              <div>
                <h3>{job.title}</h3>
                <p class="org">{job.company}</p>
              </div>
              <div class="job-when">
                <p class="label">{job.period}</p>
                <p class="label muted">{job.location}</p>
              </div>
            </div>
            <ul>
              {job.bullets.map((b) => (
                <li set:html={b} />
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
