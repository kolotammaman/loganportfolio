---
const jobs = [
  {
    title: 'Instrument Management & Customer Service Specialist',
    company: 'Penn Dental Medicine, University of Pennsylvania',
    location: 'Philadelphia, PA',
    period: 'May 2023 to present',
    bullets: [
      'Keep five specialty clinics supplied for morning and afternoon sessions. That&rsquo;s over 1,000 instruments a day, plus implant kits from four manufacturers.',
      'Built a pre-staging system around sterilizer cycle times. Urgent requests are back in 15 minutes.',
      'Came up with and developed a new inventory process for the main clinic and the Shils clinic. It cut the dispensing department&rsquo;s quarterly materials spending by 40%.',
      'Handle purchase orders, vendor payments, and repair claims with the implant companies, and keep track of what we spend.',
      'Wrote the closing checklist the sterilization team uses every day, plus onboarding and setup guides for things people used to just pass along by word of mouth.',
      'Train new staff on all five clinics and show each new class of students how the window works.',
      'Set up and break down the clinics for licensing exams twice a year.',
      'Check the oxygen tanks and keep the crash carts stocked and in date.',
      'Built a web app for the prosthodontics clinic that compares impression materials (see <a href="#built">Things I&rsquo;ve built</a>).',
    ],
  },
  {
    title: 'Operations Associate',
    company: 'The Rounds',
    location: 'Philadelphia, PA',
    period: 'Sep 2021 to Apr 2023',
    bullets: [
      'Promoted from packing and delivery within three months.',
      'Ran the warehouse for West Philly, South Philly, and Center City, usually as the only person on site.',
      'Dispatched drivers, answered the emergency hotline, and fixed late or missed deliveries without a manager around.',
      'Wrote the SOPs we used across the Philadelphia market and trained new hires on them.',
      'Worked in Asana, Airtable, Slack, OnFleet, and Google Drive every day.',
    ],
  },
  {
    title: "Young Adults Committee and Men's Group (volunteer)",
    company: 'Saint Agatha-Saint James Catholic Church',
    location: 'Philadelphia, PA',
    period: '2023 to present',
    bullets: [
      'Plan and run events for the parish&rsquo;s young adults. The bigger ones are under <a href="#events">Events</a>.',
      'Run a weekly men&rsquo;s group and make sure every meeting has a topic that fits the group.',
    ],
  },
];
---

<section id="experience" class="sec" aria-labelledby="experience-h">
  <div class="wrap sec-grid">
    <div class="sec-head"><span class="label"><span class="num">02</span>Work</span></div>
    <div class="sec-body reveal">
      <h2 id="experience-h">Where I&rsquo;ve worked</h2>
      <div>
        {jobs.map((job) => (
          <article class="job">
            <div class="job-top">
              <div>
                <h3>{job.title}</h3>
                <p class="org">{job.company}</p>
              </div>
              <div class="job-when">
                <p class="label">{job.period}</p>
                <p class="label muted">{job.location}</p>
              </div>
            </div>
            <ul>
              {job.bullets.map((b) => (
                <li set:html={b} />
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
