    <h1 class="hero-name">
      <span>Logan</span>
      <span class="indent">Moseley<span class="dot">.</span></span>
    </h1>

    <div class="hero-grid">
      <dl class="facts">
        <div>
          <dt class="label muted">Practice</dt>
          <dd>Project &amp; program operations</dd>
        </div>
        <div>
          <dt class="label muted">Based at</dt>
          <dd>Penn Dental Medicine, Philadelphia</dd>
        </div>
        <div>
          <dt class="label muted">Studying</dt>
          <dd>B.A.A.S. Leadership &amp; Communication, Penn, May 2027</dd>
        </div>
        <div>
          <dt class="label muted">Status</dt>
