---
const groups = [
  { title: 'Operations & management', skills: ['Project/program management', 'Training logistics', 'Vendor coordination', 'Version control', 'Process optimization', 'Event production', 'Cross-specialty training'] },
  { title: 'Communication', skills: ['Client/trainer liaison', 'Cross-team coordination', 'De-escalation', 'Onboarding & training', 'Status reporting'] },
  { title: 'Software & tools', skills: ['Advanced PowerPoint', 'Excel tracking', 'Google Workspace', 'Slack / Asana / Airtable', 'Adobe Illustrator & Photoshop', 'Axium'] },
  { title: 'Quick learner', skills: ['Workday', 'Concur', 'Ben Buys / purchase orders', 'OnFleet', 'Inventory systems'] },
];
---

<section id="skills" class="sec" aria-labelledby="skills-h">
  <div class="wrap sec-grid">
    <div class="sec-head"><span class="label"><span class="num">05</span>Skills</span></div>
    <div class="sec-body reveal">
      <h2 id="skills-h">My <em>toolkit.</em></h2>
      <div class="skills">
        {groups.map((g) => (
          <div class="skill-group">
            <h3>{g.title}</h3>
            <p>{g.skills.map((s, i) => (<Fragment>{i > 0 && <i>/</i>}{s}</Fragment>))}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
