---
const certs = [
  { name: 'Human Subjects Research, Biomedical', note: 'CITI Program through Penn, March 2026.' },
  { name: 'Good Clinical Practice', note: 'CITI Program through Penn, March 2026. Valid through March 2029.' },
];
---

<section id="education" class="sec" aria-labelledby="education-h">
  <div class="wrap sec-grid">
    <div class="sec-head"><span class="label"><span class="num">06</span>Education</span></div>
    <div class="sec-body reveal">
      <h2 id="education-h">Education</h2>

      <div class="edu">
        <h3>University of Pennsylvania</h3>
        <p class="label muted">College of Liberal &amp; Professional Studies</p>
        <p class="deg">B.A.A.S., Leadership and Communication. Finishing it while working full time.</p>
        <div class="tags">
          <span class="tag label">Expected May 2027</span>
        </div>
      </div>

      <div class="rows">
        {certs.map((c, i) => (
          <div class="row">
            <span class="row-no">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="row-title">{c.name}</span>
              <span class="row-desc">{c.note}</span>
            </span>
            <span class="row-meta label">Certification</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
