---
const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#events', label: 'Events & Faith' },
  { href: '#skills', label: 'Skills' },
  { href: '#education', label: 'Education' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="mast">
  <div class="wrap">
    <a href="#top" class="mark" aria-label="Logan Moseley, back to top">L. Moseley</a>
    <nav aria-label="Main navigation">
      <ul>
        {navLinks.map(({ href, label }) => (
          <li><a href={href}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <span id="clock" class="label muted clock" aria-hidden="true"></span>
  </div>
</header>
